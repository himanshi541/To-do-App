<p style="color: green"><%= notice %></p>

<% content_for :title, "Tasks" %>

<%= link_to 'New Todo',new_todo_list_path %>

<h1>Todo Lists</h1>

<table border = 1>
  <thead>
    <tr>
      <th> NAME </th>
      <th> DESCRIPTION </th>
      <th> ACTION </th>
    </tr>
  </thead>
  <tbody>
    <% @todo_lists.each do |todo_list| %>
    <tr>
        <td> <%= todo_list.name %> </td>
        <td> <%= todo_list.description%> </td>
        <td> <%= link_to 'Show' ,todo_list_path(todo_list) %></td>
      <% end %>
    </tr>
  </tbody>
